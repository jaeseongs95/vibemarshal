    "packageCommand": "/opt/codex/runtimes/codex-primary-runtime/dependencies/python/bin/python3.12 -I -S -B -X utf8 - <<'PY'\nimport os,json,hashlib,zipfile,base64,stat\nfrom pathlib import Path\nfrom datetime import datetime,timezone\nroot=Path('/workspace/vm-c5-source-24cf-r03')\nev=root/'evidence/c1-pre-70bbe-r01'\nrun=Path('/workspace/vm-c5-c1-pre-24cf-r03-01')\npost=json.loads((ev/'post-readback.json').read_bytes())\nsha=lambda b:hashlib.sha256(b).hexdigest()\ndef read(p):\n    assert not p.is_symlink() and p.is_file(),str(p)\n    for a in p.parents:\n        assert not a.is_symlink(),str(a)\n    return p.read_bytes()\ndef verify(p,r):\n    b=read(p);assert len(b)==r['bytes'] and sha(b)==r['sha256'],str(p)\n    return b\nfor r in post['candidate11After']:verify(root/'packet'/r['path'],r)\nfor r in post['fixture7After']:verify(root/'c1-fixture'/r['path'],r)\nfor r in post['runtime8After']:verify(Path(r['path']),r)\nverify(Path(post['exeAfter']['path']),post['exeAfter'])\nassert not os.path.lexists('/workspace/vm-c5-run-24cf-r03')\nassert Path('/workspace/vm-c5-run-24cf-r03').resolve()==Path('/workspace/vm-c5-run-24cf-r03')\nassert not list((root/'pre-cwd').iterdir())\nfiles={}\nfor r in post['rawFileInventory']:\n    rel=Path(r['path']);assert not rel.is_absolute() and '..' not in rel.parts\n    files['raw/'+rel.as_posix()]=verify(run/rel,r)\nassert len(files)==84\nactual=[p.relative_to(run).as_posix() for p in run.rglob('*') if p.is_file()]\nassert set(actual)==set(r['path'] for r in post['rawFileInventory'])\nfor r in post['fixture7After']:files['fixture-source/'+r['path']]=verify(root/'c1-fixture'/r['path'],r)\nfor name in ['native-page-response.json','fixture-materialization.json','post-readback.json','command-audit.json','command-records.json','outer-command.sh','outer-native-output.txt']:\n    files['support/'+name]=read(ev/name)\nfiles['prior-pre/linux-pre.stdout.json']=read(root/'evidence/linux-pre.stdout.json')\nassert len(files['prior-pre/linux-pre.stdout.json'])==114902\nassert sha(files['prior-pre/linux-pre.stdout.json'])=='3e303efd982ac83f7ef9ac68efb75bd7f3d010ce2f69fc1084ea64057ac2a9a6'\nfor name in ['SOURCE.SHA256.json','manifest.json']:\n    files['candidate-source/'+name]=read(root/'packet'/name)\ninventory={'schema':'c1-fixture-return-inventory-v1','utc':datetime.now(timezone.utc).isoformat(),'peerId':'70bbe262-a65c-43d8-a81b-76bf14eeaeb0','scope':'non_product_dummy','fixtureStatusRaw':'MATCH','actualOwnedChildPID':5265,'actualNativeExit':0,'fixtureCount':1,'childCount':1,'retry':0,'caseCount':14,'syntheticAcceptanceCounts':post['caseAcceptanceCounts'],'rawFileCount':84,'beforeFaultCount':13,'productExecuted':False,'uncaughtNativeProcessExitValidation':'UNKNOWN_NOT_RUN; synthetic outer capture only','externalJobs':'UNKNOWN','OSContainment':'UNKNOWN','nativeToolCallId':None,'providerExecutionId':None,'files':[{'path':n,'bytes':len(b),'sha256':sha(b)} for n,b in sorted(files.items())]}\nib=(json.dumps(inventory,indent=2,ensure_ascii=True)+'\\n').encode('ascii')\ndef create(p,b):\n    fd=os.open(p,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)\n    with os.fdopen(fd,'wb') as f:f.write(b)\ncreate(ev/'return-inventory.json',ib)\nfiles['RETURN-INVENTORY.json']=ib\nzp=ev/'c1-return-r01.zip'\nfd=os.open(zp,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)\nwith os.fdopen(fd,'wb') as f:\n    with zipfile.ZipFile(f,'w',compression=zipfile.ZIP_DEFLATED,compresslevel=9) as z:\n        for name,b in sorted(files.items()):\n            zi=zipfile.ZipInfo(name,date_time=(2026,10,4,0,0,0));zi.create_system=3;zi.external_attr=(stat.S_IFREG|0o600)<<16;zi.compress_type=zipfile.ZIP_DEFLATED\n            z.writestr(zi,b)\nzb=read(zp)\nwith zipfile.ZipFile(zp) as z:\n    assert len(z.namelist())==len(files) and len(set(z.namelist()))==len(files)\n    for name,b in files.items():assert z.read(name)==b\ncb=base64.b64encode(zb)+b'\\n'\nif len(cb)<=256*1024:\n    create(ev/'c1-return-r01.base64.txt',cb)\n    carriers=[{'path':str(ev/'c1-return-r01.base64.txt'),'bytes':len(cb),'sha256':sha(cb)}]\nelse:\n    carriers=[]\n    for offset in range(0,len(zb),180000):\n        part=zb[offset:offset+180000];body=base64.b64encode(part)+b'\\n'\n        pp=ev/('c1-return-r01.part%03d.base64.txt'%(offset//180000))\n        create(pp,body)\n        carriers.append({'path':str(pp),'bytes':len(body),'sha256':sha(body),'zipOffset':offset,'decodedBytes':len(part),'decodedSHA256':sha(part)})\nreceipt={'utc':datetime.now(timezone.utc).isoformat(),'zip':{'path':str(zp),'bytes':len(zb),'sha256':sha(zb),'entries':len(files)},'inventory':{'path':str(ev/'return-inventory.json'),'bytes':len(ib),'sha256':sha(ib)},'carriers':carriers,'allRawFilesPreserved':True,'sourceRuntimePinsUnchanged':True,'productRunAbsent':True,'preCwdEmpty':True,'productExecuted':False}\ncreate(ev/'return-package-receipt.json',(json.dumps(receipt,indent=2)+'\\n').encode())\nprint(json.dumps(receipt))\n\nPY",
