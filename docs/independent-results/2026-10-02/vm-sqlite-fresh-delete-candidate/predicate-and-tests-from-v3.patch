+    def test_nonzero_logical_empty_containers_are_preserved(self) -> None:
+        cases = {
+            "external-empty": ["PRAGMA user_version = 0"],
+            "vacuum-empty": ["VACUUM"],
+            "drop-history-empty": [
+                "PRAGMA secure_delete = OFF", "CREATE TABLE prior_data(value)",
+                "INSERT INTO prior_data VALUES ('synthetic-retained-history')", "DROP TABLE prior_data",
+            ],
+            "pristine-wal": ["PRAGMA journal_mode = WAL"],
+            "wal-bootstrap-rollback": [
+                "PRAGMA journal_mode = WAL", "BEGIN IMMEDIATE", "CREATE TABLE bootstrap(value)", "ROLLBACK",
+            ],
+        }
+        for name, statements in cases.items():
+            with self.subTest(case=name):
+                path = self.root / (name + ".sqlite3")
+                with closing(sqlite3.connect(path, isolation_level=None)) as connection:
+                    for statement in statements:
+                        connection.execute(statement)
+                before = path.read_bytes()
+                self.assertGreater(len(before), 0)
+                if name == "drop-history-empty":
+                    self.assertIn(b"synthetic-retained-history", before)
+                ledger = SQLiteEngineLedger(path)
+                with closing(sqlite3.connect(path)) as connection:
+                    self.assertEqual([], connection.execute("SELECT name FROM sqlite_master").fetchall())
+                    self.assertEqual(0, connection.execute("PRAGMA application_id").fetchone()[0])
+                    self.assertEqual(0, connection.execute("PRAGMA user_version").fetchone()[0])
+                    mode = connection.execute("PRAGMA journal_mode").fetchone()[0]
+                with self.assertRaises(EngineLedgerError):
+                    ledger.initialize()
+                self.assertEqual(before, path.read_bytes())
+                self.assertFalse(ledger.artifact_root.exists())
+                with closing(sqlite3.connect(path)) as connection:
+                    self.assertEqual([], connection.execute("SELECT name FROM sqlite_master").fetchall())
+                    self.assertEqual(0, connection.execute("PRAGMA application_id").fetchone()[0])
+                    self.assertEqual(0, connection.execute("PRAGMA user_version").fetchone()[0])
+                    self.assertEqual(mode, connection.execute("PRAGMA journal_mode").fetchone()[0])
+
+    def test_cache_spill_failure_rolls_back_to_zero_and_retries(self) -> None:
+        original = self.ledger._connect
+        spilled_sizes = []
+        path = self.path
+
+        class FaultConnection(ConnectionProxy):
+            def commit(self):
+                spilled_sizes.append(path.stat().st_size)
+                raise RuntimeError("synthetic precommit spill failure")
+
+        def connect(**options):
+            connection = original(**options)
+            connection.execute("PRAGMA cache_size = 10")
+            connection.execute("PRAGMA cache_spill = ON")
+            return FaultConnection(connection)
+
+        with patch.object(self.ledger, "_connect", connect):
+            with self.assertRaisesRegex(RuntimeError, "precommit spill failure"):
+                self.ledger.initialize()
+        self.assertEqual(1, len(spilled_sizes))
+        self.assertGreater(spilled_sizes[0], 0)
+        self.assert_empty(self.path)
+        self.ledger.initialize()
+        self.assert_valid(self.ledger)
+
+    def test_hot_journal_recovery_precedes_locked_zero_size_check(self) -> None:
+        self.run_process(crash_initialize, (str(self.path), "spill"), 75)
+        self.assertGreater(self.path.stat().st_size, 0)
+        journal = Path(str(self.path) + "-journal")
+        self.assertGreater(journal.stat().st_size, 512)
+        self.assertEqual(bytes.fromhex("d9d505f920a163d7"), journal.read_bytes()[:8])
+        original_connect = self.ledger._connect
+        original_stat = Path.stat
+        acquired = []
+        samples = []
+        path = self.path
+
+        def connect(**options):
+            connection = original_connect(**options)
+            acquired.append(connection)
+            return connection
+
+        def stat(target, *args, **options):
+            result = original_stat(target, *args, **options)
+            if target == path:
+                connection = acquired[0]
+                samples.append((
+                    connection.in_transaction, result.st_size,
+                    connection.execute("PRAGMA application_id").fetchone()[0],
+                    connection.execute("PRAGMA user_version").fetchone()[0],
+                    connection.execute("SELECT name FROM sqlite_master").fetchall(),
+                ))
+            return result
+
+        # pre-open size를 gate로 쓰면 이 native hot-journal 복구를 놓친다.
+        with patch.object(self.ledger, "_connect", connect), patch.object(Path, "stat", stat):
+            self.ledger.initialize()
+        self.assertEqual([(True, 0, 0, 0, [])], samples)
+        self.assert_valid(self.ledger)
+
+    def test_committed_foreign_wal_data_are_preserved(self) -> None:
+        wal = Path(str(self.path) + "-wal")
+        with closing(sqlite3.connect(self.path)) as writer:
+            writer.execute("PRAGMA journal_mode = WAL")
+            writer.execute("PRAGMA wal_autocheckpoint = 0")
+            writer.execute("CREATE TABLE foreign_data(value)")
+            writer.execute("INSERT INTO foreign_data VALUES (7)")
+            writer.commit()
+            before = self.path.read_bytes(), wal.read_bytes()
+            self.assertGreater(len(before[1]), 0)
+            with self.assertRaises(EngineLedgerError):
+                self.ledger.initialize()
+            self.assertEqual(before, (self.path.read_bytes(), wal.read_bytes()))
+            self.assertEqual([(7,)], writer.execute("SELECT value FROM foreign_data").fetchall())
+            self.assertEqual(0, writer.execute("PRAGMA application_id").fetchone()[0])
+            self.assertEqual(0, writer.execute("PRAGMA user_version").fetchone()[0])
+            self.assertEqual("wal", writer.execute("PRAGMA journal_mode").fetchone()[0])
+        self.assertFalse(self.ledger.artifact_root.exists())
+
+    def test_existing_engine_data_are_preserved_by_reinitialize(self) -> None:
