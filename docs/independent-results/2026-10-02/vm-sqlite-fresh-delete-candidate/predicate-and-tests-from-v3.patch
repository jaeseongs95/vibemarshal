+        self.ledger.initialize()
+        self.assertEqual(before_bytes, self.path.read_bytes())
+        with closing(sqlite3.connect(self.path)) as connection:
+            self.assertEqual(before_dump, list(connection.iterdump()))
+        self.assert_valid(self.ledger)
+        self.assertTrue(self.ledger.verify_history("project"))
