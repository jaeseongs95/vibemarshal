+                "VALUES ('project','preserve','synthetic-root','synthetic-artifacts','idle',?,?)",
+                (tx.now, tx.now),
+            )
+            tx.history("project", "project.created", "project", "project", {})
+        with closing(sqlite3.connect(self.path)) as connection:
